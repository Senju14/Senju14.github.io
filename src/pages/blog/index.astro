---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Blog | My Portfolio" currentTab="Blog">
    <div id="Blog" class="tab-content active-tab" style="display: block;">
        
        <div class="blog-list">
            <article class="blog-card fade-in-section">
                <div class="blog-card-content">
                    <span class="blog-category">System Architecture</span>
                    <h2 class="blog-card-title"><a href="/blog/agentic-rag-system">Building an Agentic RAG System for Enterprise Documents</a></h2>
                    <div class="blog-meta">
                        <span><i class="fa-regular fa-calendar"></i> May 6, 2026</span>
                        <span><i class="fa-regular fa-clock"></i> 5 min read</span>
                    </div>
                    <p class="blog-excerpt">
                        Retrieval-Augmented Generation (RAG) has become the standard for grounding Large Language Models (LLMs) in proprietary data. However, standard RAG pipelines often struggle with complex, multi-hop reasoning queries. Learn how an Agentic approach solves this.
                    </p>
                    <a href="/blog/agentic-rag-system" class="read-more-btn">Read More <i class="fa-solid fa-arrow-right"></i></a>
                </div>
            </article>

            <article class="blog-card fade-in-section">
                <div class="blog-card-content">
                    <span class="blog-category">Deep Learning</span>
                    <h2 class="blog-card-title"><a href="/blog/bilingual-speech-to-text">Scaling Bilingual Speech-to-Text on Serverless GPUs</a></h2>
                    <div class="blog-meta">
                        <span><i class="fa-regular fa-calendar"></i> Apr 15, 2026</span>
                        <span><i class="fa-regular fa-clock"></i> 7 min read</span>
                    </div>
                    <p class="blog-excerpt">
                        Exploring the challenges and solutions in deploying WhisperX and NLLB models on Modal for real-time Vietnamese/English lecture translation. We achieved significant latency reduction using Silero VAD for segmentation.
                    </p>
                    <a href="/blog/bilingual-speech-to-text" class="read-more-btn">Read More <i class="fa-solid fa-arrow-right"></i></a>
                </div>
            </article>
        </div>

    </div>
</Layout>

<style>
    .blog-list {
        display: flex;
        flex-direction: column;
        gap: 20px;
        margin: 20px auto 0;
        max-width: 650px;
    }
    .blog-card {
        border: 1px solid var(--border-color);
        border-radius: 10px;
        padding: 22px 25px;
        background-color: var(--bg-color);
        box-shadow: 0 4px 15px rgba(0,0,0,0.02);
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .blog-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.05);
    }
    .blog-card-title {
        font-size: 1.35rem;
        margin-bottom: 10px;
        line-height: 1.3;
        border: none;
        padding: 0;
    }
    .blog-card-title a {
        color: var(--text-color);
        text-decoration: none;
    }
    .blog-card-title a:hover {
        color: var(--link-hover);
    }
    .blog-meta {
        justify-content: flex-start;
        margin-bottom: 12px;
        font-size: 0.85rem;
    }
    .blog-excerpt {
        color: var(--secondary-text);
        margin-bottom: 16px;
        line-height: 1.6;
        font-size: 0.95rem;
    }
    .read-more-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-weight: 600;
        color: var(--link-hover);
        text-decoration: none;
        font-size: 0.9rem;
        transition: gap 0.2s;
    }
    .read-more-btn:hover {
        gap: 10px;
    }
</style>
