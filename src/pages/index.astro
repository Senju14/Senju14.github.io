    <script>
        // Scrollytelling Timeline Logic
        const timelineContainer = document.querySelector('.timeline-container');
        const timelineItems = document.querySelectorAll('.timeline-item');
        const lineFill = document.querySelector('.timeline-line-fill');

        function updateTimeline() {
            if (!timelineContainer || !lineFill) return;
            
            const rect = timelineContainer.getBoundingClientRect();
            const viewportHeight = window.innerHeight;
            
            // Calculate the trigger point (middle of the viewport)
            const triggerPoint = viewportHeight / 2;
            
            // Progress calculation
            const containerHeight = rect.height;
            const scrolledDistance = triggerPoint - rect.top;
            
            let progress = (scrolledDistance / containerHeight) * 100;
            progress = Math.max(0, Math.min(100, progress));
            
            // Set the fill height
            (lineFill as HTMLElement).style.height = `${progress}%`;
            
            // Toggle active state for milestone cards
            timelineItems.forEach(item => {
                const itemRect = item.getBoundingClientRect();
                if (itemRect.top < triggerPoint) {
                    item.classList.add('active');
                } else {
                    item.classList.remove('active');
                }
            });
        }

        // Add event listeners for scroll and resize
        window.addEventListener('scroll', updateTimeline);
        window.addEventListener('resize', updateTimeline);
        
        // Initial call after component mount
        setTimeout(updateTimeline, 200);
    </script>
</Layout>
