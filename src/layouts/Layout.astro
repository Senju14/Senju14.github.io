---
export interface Props {
	title: string;
	currentTab: string;
}

const { title, currentTab } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Portfolio of Nguyen Nhat Huy - AI/Machine Learning Engineer">
    
    <!-- Security Headers for GitHub Pages -->
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https:; connect-src 'self'; frame-src https://www.youtube.com https://*.hf.space;">
    <meta name="referrer" content="strict-origin-when-cross-origin">
    
    <script is:inline>
        if (window.top !== window.self) { window.top.location = window.self.location; }
    </script>

    <!-- SEO & Open Graph Tags -->
    <meta property="og:title" content="Nguyen Nhat Huy - AI / Machine Learning Engineer">
    <meta property="og:description" content="Portfolio of Nguyen Nhat Huy. Passionate about researching and building real-world AI applications, specializing in model fine-tuning and RAG architectures.">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://senju14.github.io/">
    <meta property="og:image" content="https://visitor-badge.laobi.icu/badge?page_id=Senju14.github.io">
    
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>👨‍💻</text></svg>">

    <title>{title}</title>

    <script is:inline>
        const savedTheme = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        if (savedTheme === 'dark') { document.documentElement.setAttribute('data-theme', 'dark'); }
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin>

    <link rel="stylesheet" href="/style.css">
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" media="print" onload="this.media='all'">
    <noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"></noscript>
</head>
<body>
    <div class="layout">
        <aside class="sidebar" id="sidebar">
            <h3 class="sidebar-title">Contents</h3>
            <nav class="toc">
                <a href={currentTab === 'Bio' ? '#about' : '/#about'}>About</a>
                <a href={currentTab === 'Bio' ? '#education' : '/#education'}>Education</a>
                <a href={currentTab === 'Bio' ? '#journey' : '/#journey'}>Journey</a>
                <a href={currentTab === 'Bio' ? '#projects' : '/#projects'}>Projects</a>
                <a href={currentTab === 'Bio' ? '#skills' : '/#skills'}>Skills</a>
            </nav>
        </aside>

        <main class="main-content">
            <div class="top-bar">
                <div class="stat-item">
                    <img src="https://visitor-badge.laobi.icu/badge?page_id=Senju14.github.io" alt="visitor badge" class="visitor-badge">
                </div>
                <div class="stat-item">
                    <i class="fa-regular fa-clock"></i> Last updated: Jul 07, 2026
                </div>


                <button id="darkModeToggle" class="theme-toggle" aria-label="Toggle Dark Mode" title="Toggle Dark Mode">
                    <i class="fa-solid fa-moon"></i>
                </button>
            </div>

            <header>
                <h1>NGUYEN NHAT HUY</h1>
                <div class="subtitle"><span id="typewriter"></span><span class="cursor"></span></div>
                <div class="location">Ho Chi Minh City, Vietnam</div>
                
                <div class="social-links">
                    <a href="mailto:huynguyenwork14@gmail.com" title="Click to send email" class="email-link">huynguyenwork14@gmail.com <i class="fa-solid fa-up-right-from-square link-indicator" aria-hidden="true"></i></a>
                    <a href="https://linkedin.com/in/huy-nguyen14/" target="_blank" rel="noopener noreferrer" title="Click to open LinkedIn" class="icon-linkedin"><i class="fa-brands fa-linkedin"></i></a>
                    <a href="https://github.com/Senju14" target="_blank" rel="noopener noreferrer" title="Click to open GitHub" class="icon-github"><i class="fa-brands fa-github"></i></a>
                    <a href="https://huggingface.co/522H0134-NguyenNhatHuy" target="_blank" rel="noopener noreferrer" title="Click to open Hugging Face" class="icon-hf">
                        <img src="https://huggingface.co/front/assets/huggingface_logo-noborder.svg" alt="Hugging Face">
                    </a>
                </div>
            </header>

            <div class="tabs">
                <a href="/" class={`tab-btn ${currentTab === 'Bio' ? 'active' : ''}`} style="text-decoration: none; display: inline-block;">Bio</a>
                <a href="/blog" class={`tab-btn ${currentTab === 'Blog' ? 'active' : ''}`} style="text-decoration: none; display: inline-block;">Blog</a>
                <a href="/arcade" class={`tab-btn ${currentTab === 'Arcade' ? 'active' : ''}`} style="text-decoration: none; display: inline-block;">Arcade</a>
            </div>

            <slot />

            <footer>
                <p>&copy; 2026 Nguyen Nhat Huy. All rights reserved.</p>
            </footer>
        </main>
    </div>

    <!-- Hamburger button for mobile sidebar -->
    <button id="hamburgerBtn" class="hamburger-btn" aria-label="Toggle navigation menu" title="Menu">
        <span></span>
        <span></span>
        <span></span>
    </button>
    <!-- Sidebar backdrop overlay -->
    <div id="sidebarOverlay" class="sidebar-overlay"></div>

    <button id="goTopBtn" class="go-top-btn" type="button" aria-label="Go to top" title="Go to top">
        <i class="fa-solid fa-arrow-up"></i>
    </button>

    <!-- Interactive AI Mascot -->
    <div class="mascot-container" id="mascotContainer">
        <div class="mascot-bubble" id="mascotBubble">
            Hi! I'm Robo-Huy. Click me for a cool developer joke!
        </div>
        <div class="mascot-avatar" id="mascotAvatar" aria-label="Mascot avatar">
            <div class="mascot-notification-dot" id="mascotDot"></div>
            <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
                <!-- Body/Head -->
                <circle cx="50" cy="50" r="40" fill="#3b82f6" stroke="#1d4ed8" stroke-width="4" />
                <!-- Screen Face -->
                <rect x="22" y="25" width="56" height="42" rx="10" fill="#1e293b" stroke="#0f172a" stroke-width="3" />
                <!-- Eyes Background -->
                <circle cx="38" cy="45" r="10" fill="#0f172a" />
                <circle cx="62" cy="45" r="10" fill="#0f172a" />
                <!-- Pupils (Interactive) -->
                <circle id="leftPupil" class="pupil" cx="38" cy="45" r="4" fill="#60a5fa" />
                <circle id="rightPupil" class="pupil" cx="62" cy="45" r="4" fill="#60a5fa" />
                <!-- Mouth -->
                <path d="M 40 58 Q 50 64 60 58" stroke="#60a5fa" stroke-width="3" fill="none" stroke-linecap="round" />
                <!-- Antenna -->
                <line x1="50" y1="10" x2="50" y2="2" stroke="#1d4ed8" stroke-width="4" />
                <circle cx="50" cy="2" r="4" fill="#ef4444" />
            </svg>
        </div>
    </div>

    <script is:inline>
        (function () {
            var goTopBtn = document.getElementById('goTopBtn');
            if (!goTopBtn) return;
            function updateGoTopButton() {
                var showOnMobile = window.innerWidth <= 850 && window.scrollY > 220;
                goTopBtn.classList.toggle('show', showOnMobile);
            }
            goTopBtn.addEventListener('click', function () {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            });
            window.addEventListener('scroll', updateGoTopButton);
            window.addEventListener('resize', updateGoTopButton);
            updateGoTopButton();
        })();
        // Hamburger / Sidebar drawer logic
        (function() {
            var hamburger = document.getElementById('hamburgerBtn');
            var sidebar = document.getElementById('sidebar');
            var overlay = document.getElementById('sidebarOverlay');
            if (!hamburger || !sidebar || !overlay) return;

            function openSidebar() {
                sidebar.classList.add('open');
                hamburger.classList.add('open');
                overlay.classList.add('visible');
                document.body.style.overflow = 'hidden';
            }

            function closeSidebar() {
                sidebar.classList.remove('open');
                hamburger.classList.remove('open');
                overlay.classList.remove('visible');
                document.body.style.overflow = '';
            }

            hamburger.addEventListener('click', function(e) {
                e.stopPropagation();
                if (sidebar.classList.contains('open')) {
                    closeSidebar();
                } else {
                    openSidebar();
                }
            });

            overlay.addEventListener('click', closeSidebar);

            // Close when a nav link is clicked on mobile
            sidebar.querySelectorAll('.toc a').forEach(function(link) {
                link.addEventListener('click', function() {
                    if (window.innerWidth <= 1100) {
                        closeSidebar();
                    }
                });
            });

            // Close on Escape key
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape') closeSidebar();
            });

            // Reset state on resize back to desktop
            window.addEventListener('resize', function() {
                if (window.innerWidth > 1100) {
                    closeSidebar();
                }
            });
        })();

        // Dark Mode Logic
        const themeToggle = document.getElementById('darkModeToggle');
        const themeIcon = themeToggle.querySelector('i');
        
        if (document.documentElement.getAttribute('data-theme') === 'dark') {
            themeIcon.classList.replace('fa-moon', 'fa-sun');
        }

        themeToggle.addEventListener('click', () => {
            if (document.documentElement.getAttribute('data-theme') === 'dark') {
                document.documentElement.removeAttribute('data-theme');
                localStorage.setItem('theme', 'light');
                themeIcon.classList.replace('fa-sun', 'fa-moon');
            } else {
                document.documentElement.setAttribute('data-theme', 'dark');
                localStorage.setItem('theme', 'dark');
                themeIcon.classList.replace('fa-moon', 'fa-sun');
            }
        });

        // Interactive Mascot Logic
        const mascotAvatar = document.getElementById('mascotAvatar');
        const mascotBubble = document.getElementById('mascotBubble');
        const leftPupil = document.getElementById('leftPupil');
        const rightPupil = document.getElementById('rightPupil');
        const mascotDot = document.getElementById('mascotDot');

        const jokes = [
            "Why did the neural network go to therapy? It had too many hidden layers! 😂",
            "I'm training a model to predict if you'll hire me. Spoiler: P(hire) = 0.99! 🚀",
            "There are 10 types of people: those who understand binary, and those who don't. 💻",
            "Why do ML engineers love coffee? Because it provides automatic feature boosting! ☕",
            "Grace Hopper found the first real computer 'bug' (a moth) in 1947. Retro debugging! 🦋",
            "To understand recursion, you must first understand recursion. 🌀",
            "AI is 80% data cleaning, 20% model training, and 100% hoping it doesn't overfit! 📊"
        ];

        let bubbleTimeout;

        function showJoke() {
            // Remove notification dot on first click
            if (mascotDot) {
                mascotDot.style.display = 'none';
            }
            const randomJoke = jokes[Math.floor(Math.random() * jokes.length)];
            mascotBubble.textContent = randomJoke;
            mascotBubble.classList.add('show');

            clearTimeout(bubbleTimeout);
            bubbleTimeout = setTimeout(() => {
                mascotBubble.classList.remove('show');
            }, 6000); // hide after 6s
        }

        if (mascotAvatar && mascotBubble) {
            mascotAvatar.addEventListener('click', showJoke);
            // Also support tap on mobile
            mascotAvatar.addEventListener('touchstart', function(e) {
                e.preventDefault();
                showJoke();
            }, { passive: false });
        }


        // Eye Tracking Logic
        document.addEventListener('mousemove', (e) => {
            if (!leftPupil || !rightPupil || !mascotAvatar) return;
            
            const avatarRect = mascotAvatar.getBoundingClientRect();
            const avatarCenterX = avatarRect.left + avatarRect.width / 2;
            const avatarCenterY = avatarRect.top + avatarRect.height / 2;

            const angle = Math.atan2(e.clientY - avatarCenterY, e.clientX - avatarCenterX);
            const maxDisplacement = 4;
            const dx = Math.cos(angle) * maxDisplacement;
            const dy = Math.sin(angle) * maxDisplacement;

            leftPupil.setAttribute('transform', `translate(${dx}, ${dy})`);
            rightPupil.setAttribute('transform', `translate(${dx}, ${dy})`);
        });

        // Show welcome bubble on load after 3s
        setTimeout(() => {
            if (mascotBubble) {
                mascotBubble.classList.add('show');
                setTimeout(() => {
                    mascotBubble.classList.remove('show');
                }, 4000);
            }
        }, 3000);

        // Scroll Animation Logic
        const observerOptions = { root: null, rootMargin: '0px', threshold: 0.1 };
        const observer = new IntersectionObserver((entries, observer) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('is-visible');
                    observer.unobserve(entry.target);
                }
            });
        }, observerOptions);

        document.querySelectorAll('section, .blog-post, .blog-card').forEach(el => {
            el.classList.add('fade-in-section');
            observer.observe(el);
        });

        // Typewriter Effect (EDIT WORDS HERE)
        const roles = [
            "AI / Machine Learning Engineer", 
            "NLP Researcher", 
            "RAG System Developer", 
            "AI Developer"
        ];
        
        let roleIndex = 0;
        let charIndex = 0;
        let isDeleting = false;
        const typewriterElement = document.getElementById("typewriter");

        function type() {
            if (!typewriterElement) return;
            const currentRole = roles[roleIndex];
            
            if (isDeleting) {
                typewriterElement.textContent = currentRole.substring(0, charIndex - 1);
                charIndex--;
            } else {
                typewriterElement.textContent = currentRole.substring(0, charIndex + 1);
                charIndex++;
            }

            let typeSpeed = isDeleting ? 50 : 100;

            if (!isDeleting && charIndex === currentRole.length) {
                typeSpeed = 2000;
                isDeleting = true;
            } else if (isDeleting && charIndex === 0) {
                isDeleting = false;
                roleIndex = (roleIndex + 1) % roles.length;
                typeSpeed = 500;
            }

            setTimeout(type, typeSpeed);
        }

        if (typewriterElement) {
            setTimeout(type, 1000);
        }
    </script>
</body>
</html>
